# Test image — separate from the production Dockerfile so nothing here (devDependencies,
# the test tree, a root-writable /app) can reach the runtime image.
#
# node_modules is built inside the image rather than bind-mounted, which is also what
# makes this the reliable way to run the suite: sharp ships platform-specific binaries,
# and a host node_modules from a different OS/arch won't load here.
FROM node:26-alpine

WORKDIR /app

# Deliberately no extra tooling: /api/backups shells out to tar, and the point is to
# exercise it against the same busybox tar the runtime image has (which does accept the
# -czf/-xzf plus --no-same-owner/--no-same-permissions this app passes).
COPY package*.json ./
RUN npm ci

COPY tsconfig.json vitest.config.ts ./
COPY src ./src
COPY test ./test

# Drop to the base image's unprivileged user. /app is chowned first because npm ci and the
# COPYs above run as root, and both consumers of this image write inside it: vitest caches
# under node_modules, and the app-e2e service writes its throwaway data directory.
RUN chown -R node:node /app
USER node

CMD ["npx", "vitest", "run"]
