{
  "name": "mach-alliance-catalog-generator",
  "version": "1.0.0",
  "description": "Generates sample product catalogs for MACH Alliance reference implementations.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "MACH Alliance",
    "url": "https://machalliance.org/"
  },
  "homepage": "https://github.com/machalliance/solution-studio-catalog-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machalliance/solution-studio-catalog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/machalliance/solution-studio-catalog-generator/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node_modules/.bin/tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm unit",
    "test:e2e:docker": "docker compose -f docker-compose.test.yml run --rm e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.101",
    "@ai-sdk/gateway": "^4.0.141",
    "@ai-sdk/google": "^4.0.116",
    "@ai-sdk/openai": "^4.0.113",
    "@ai-sdk/openai-compatible": "^3.0.89",
    "@hono/node-server": "^1.13.7",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.168",
    "archiver": "^7.0.1",
    "hono": "^4.13.17",
    "sharp": "^0.35.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
