{
  "name": "catalog-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node_modules/.bin/tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm unit",
    "test:e2e:docker": "docker compose -f docker-compose.test.yml run --rm e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/gateway": "^4.0.63",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.36",
    "@hono/node-server": "^1.13.7",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.78",
    "archiver": "^7.0.1",
    "hono": "^4.6.20",
    "sharp": "^0.35.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
