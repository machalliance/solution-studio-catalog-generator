LLM_CLAUDE_FAST=claude-haiku-4-5-20251001

OPENAI_API_KEY=
LLM_OPENAI_CHAT=gpt-4o
LLM_OPENAI_FAST=gpt-4o-mini

# Product Catalog Generator specific
PORT=3004
# CATALOG_PATH and IMAGES_PATH default to data/catalog and data/images inside the container.
# Override here if volume mounts map to different internal paths.
CATALOG_PATH=
IMAGES_PATH=
# Bearer token required on /catalog/* (the API other services consume). Leave empty to
# leave that surface open — fine for local dev, not recommended if it's reachable by anyone else.
STUDIO_API_TOKEN=
