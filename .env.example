# ── Model access ──────────────────────────────────────────────────────────────
# WHICH models to use, and WHICH route to reach them by, are not set here — they live in
# config.json and are editable at runtime from Settings. This file holds only the
# credentials and endpoints for each route, which deliberately are not settable from the
# UI: /api/* is unauthenticated by design, and a base URL that could be set through it
# would let anyone reaching the port redirect billed calls (and the API key with them) to
# a host they control.
#
# Set the keys for whichever route you selected in Settings → Models. The others can stay
# empty. Model IDs are always "<provider>/<name>" — e.g. anthropic/claude-opus-5.

# Route: direct — straight at the vendors. The default.
ANTHROPIC_API_KEY=      # required for anthropic/* models on this route
OPENAI_API_KEY=         # required for openai/* models on this route

# Route: gateway — Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Route: openrouter — OpenRouter.
OPENROUTER_API_KEY=

# Route: compatible — any OpenAI-compatible endpoint (a proxy, LiteLLM, an internal
# gateway). LLM_BASE_URL is required by this route; there is no default to fall back to.
LLM_BASE_URL=
LLM_API_KEY=

# Optional per-route endpoint overrides. Leave unset to use each provider's own default —
# only needed to point a route at a mirror, a regional endpoint, or a recording proxy.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# AI_GATEWAY_BASE_URL=
# OPENROUTER_BASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3004
# The Docker-published port binds to loopback (127.0.0.1) by default — reachable from this
# machine only. Set to 0.0.0.0 only if you need another device on a trusted local network
# to reach it (that also exposes /api/*'s unauthenticated destructive/billed routes to that
# network). Never set this on a public host or anything reachable from the open internet.
# No TLS either way — this is plain HTTP. Put a reverse proxy or VPN in front of it if
# you're reaching it from anywhere but this machine; see SECURITY.md.
BIND_ADDRESS=
# Runs the container as this UID/GID instead of the image's default (node, 1000:1000), so
# writes to CATALOG_HOST_PATH/IMAGES_HOST_PATH below actually work when they're owned by a
# different host user/group. Find yours with `id -u` / `id -g`. Leave unset to keep the
# image default (fine when CATALOG_HOST_PATH/IMAGES_HOST_PATH are also left empty).
HOST_UID=
HOST_GID=
# Where product data/images actually live on this machine — used both for the Docker
# volume mount (docker-compose.yml) and shown in Settings. Leave empty to keep everything
# self-contained inside this project (./data/catalog, ./data/images) — the default. Or
# point at another location on the same machine (e.g. a sibling project) to share data
# with it directly. Requires a container recreate (`docker compose up -d`), not just a
# restart, to take effect — same as any other value in this file.
CATALOG_HOST_PATH=
IMAGES_HOST_PATH=
CATALOG_PATH=           # product JSON fixtures — defaults to /app/data/catalog in Docker
IMAGES_PATH=            # generated/uploaded images — defaults to /app/data/images in Docker
STUDIO_API_TOKEN=       # bearer token for the /catalog/* API — omit to leave it open
# Off by default: /generate-items omits "brand" entirely rather than risk the model reaching
# for a real, currently-trading company name (asked for "realistic" items with no other
# constraint, it will). Set to true to have it invent a fictional house-brand instead.
SHOW_BRAND=
