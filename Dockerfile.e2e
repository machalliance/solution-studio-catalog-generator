# Browser test image. Debian rather than the Alpine base the app uses, because that is
# what Playwright supports and ships browser builds for — the app itself is exercised
# over HTTP, so the OS underneath the browser is not part of what's being tested.
FROM node:26-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Installs the Chromium build matching the @playwright/test version npm just resolved,
# plus its system libraries. Browsers land in a shared path rather than root's ~/.cache so
# the unprivileged user below can still find them; --with-deps needs apt, hence root here.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium \
 && chmod -R a+rX /ms-playwright

COPY tsconfig.json playwright.config.ts ./
COPY src ./src
COPY test ./test

# Drop to the base image's unprivileged user. Playwright writes test-results/ and, under
# CI, playwright-report/ into /app, so it has to own that. Chromium itself is unaffected:
# Playwright runs it with its sandbox disabled either way.
RUN chown -R node:node /app
USER node

CMD ["npx", "playwright", "test"]
